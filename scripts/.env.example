# SaluteSpeech API settings
# Never commit real tokens or real secrets.

# Variant A: paste ready access token from SaluteSpeech UI
SBER_SALUTE_TOKEN=

# Variant B: credentials for token request, if used later
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_SCOPE=PERS

# Voice settings
SBER_TTS_VOICE=
SBER_TTS_AUDIO_FORMAT=mp3
SBER_TTS_SAMPLE_RATE=24000

# Optional endpoint overrides
SBER_TTS_URL=
SBER_TOKEN_URL=
