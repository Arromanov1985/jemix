# Скопируйте файл в .env и заполните один вариант авторизации.

# Вариант 1: API-ключ сервисного аккаунта
YANDEX_API_KEY=

# Вариант 2: IAM-токен
YANDEX_IAM_TOKEN=

# Folder ID нужен при IAM-токене; с API-ключом обычно не требуется
YANDEX_FOLDER_ID=

YANDEX_VOICE=ermil
YANDEX_EMOTION=good
YANDEX_SPEED=1.0
YANDEX_FORMAT=mp3
